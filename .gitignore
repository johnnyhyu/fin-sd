# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
# ANCHORED: an unanchored `build/` matches a directory of that name at ANY depth,
# which silently swallows data/build/ — the corpus construction chain. Same class
# of bug that previously hid scripts/, tests/ and visualizers/ from git entirely.
/dist/
/build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# macOS / IDE
.DS_Store
.vscode/
.idea/

# ── Run outputs ──────────────────────────────────────────────────────────────
# Everything below is regenerated by a run. None of it is source.

# Model checkpoints and merged weights (a 20B merged checkpoint is ~39 GiB).
*.bin
*.safetensors
*.pt
*.ckpt
checkpoints/
outputs/

# Training logs and intermediate corpus-build artifacts. The build chain in
# data/build/ resumes from whatever it already wrote, so these reappear on a
# partial re-run; only the finished corpus (trainingset/problemset/
# function-library) is tracked.
wandb/
data/answers.json
data/grades.json
data/feedback.json
data/raw_problemset.json
data/extra_problemset.json
data/functions-graded.json
data/functions-hard.json
data/functions-hard-filtered.json
data/reasoning_log.jsonl
data/teacher_rollouts.jsonl
data/expert_profile.json
data/expert_finance_diff.json
# Byte-identical duplicate of the copy vendored with FinanceReasoning, which is
# what data/build/phase1 now reads. Kept out of the tree rather than shipped twice.
data/functions-article-all.json

# Benchmark run artifacts.
FinTrust/logs/
FinanceReasoning/results/
MMLU-Pro/eval_results/
MMLU-Pro/results/
benchmarks/FinTrust/logs/
benchmarks/FinanceReasoning/results/
benchmarks/MMLU-Pro/eval_results/
benchmarks/MMLU-Pro/results/
contrib/big-finance-benchmark/runs/

# FinTrust writes each model's responses into the SAME directory as the dataset
# that produced them, so this matches generated names rather than a directory.
# Inputs are `<task>_evaluation_<N>.json{,l}`; every generated file carries an
# `output` segment. No tracked FinTrust path contains that substring.
**/FinTrust/**/*output*

# Two evaluation.json copies at the FinanceReasoning root, serving as
# mcnemar_test.py's default arguments. Run output despite the source-like names.
**/FinanceReasoning/flash.json
**/FinanceReasoning/self.json

# Per-run benchmark configs, one per checkpoint arm, each naming a specific
# checkpoint and passed with --config. Nothing imports them. Each benchmark's
# config.yaml is the committed template and is whitelisted back in.
**/FinTrust/config/*.yaml
!**/FinTrust/config/config.yaml
**/MMLU-Pro/config/*.yaml
!**/MMLU-Pro/config/config.yaml
**/big-finance-benchmark/config/*.yaml
!**/big-finance-benchmark/config/config.yaml
