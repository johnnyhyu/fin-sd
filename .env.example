# Copy to .env and fill in. Nothing here is read unless .env exists.
#
#   cp .env.example .env
#
# Only OPENROUTER_API_KEY is required for a default run: the equivalence judge
# that grades student answers runs through OpenRouter. Everything else has a
# working default in pipeline/config.py.
#
# Precedence: shell environment > configs/ preset > .env > code default.
# Per-run knobs (which arm, which seed) belong in a preset, not here — see
# configs/finsd.env. This file is for machine-local settings and credentials.

# ── Credentials ───────────────────────────────────────────────────────────────
# Grades student answers (equivalence judge) and, on the 120B-hint arm, writes
# hints. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Shared secret for the managed vLLM server. Any non-empty string; it never
# leaves localhost.
VLLM_API_KEY=token-abc123

# ── Serving ───────────────────────────────────────────────────────────────────
# The pipeline OWNS the vLLM process — it starts the server and restarts it on a
# freshly merged checkpoint at each epoch boundary. Do NOT run `vllm serve`
# yourself; it collides on the port. See docs/ARCHITECTURE.md.
VLLM_BASE_URL=http://localhost:8000/v1

# GPUs for serving. MUST stay disjoint from the training GPUs. Ignored for the
# default 20B BF16 student, which auto-picks the next two idle cards (first for
# vLLM, second for the trainer).
# VLLM_GPUS=0,1
# VLLM_TENSOR_PARALLEL=2
# VLLM_GPU_MEM_UTIL=0.9
# VLLM_MAX_MODEL_LEN=16384

# ── Models ────────────────────────────────────────────────────────────────────
# The student. Expert LoRA (LORA_TARGET_EXPERTS=1) requires BF16 weights for both
# entries, since the merged checkpoint vLLM serves is full precision.
# HF_MODEL_PATH=unsloth/gpt-oss-20b-BF16
# VLLM_MODEL=unsloth/gpt-oss-20b

# ── Logging ───────────────────────────────────────────────────────────────────
# Weights & Biases is OFF by default so a fresh clone trains without an account.
# "disabled" makes wandb.init/log no-ops — no login, no network. Set to "online"
# to log a run, and fill in your own entity.
WANDB_MODE=disabled
WANDB_ENTITY=
WANDB_PROJECT=pipeline

# ── Compute backend ───────────────────────────────────────────────────────────
# 0 = local GPUs, 1 = dispatch the whole pipeline to Modal. See modal_app.py for
# the one-time Modal setup.
USE_MODAL=0
# MODAL_GPU=A100-80GB:8

# ── contrib/big-finance-benchmark only ────────────────────────────────────────
# Not used by anything in the paper. Its tools need their own credentials.
# SERP_API_KEY=
# SEC_EDGAR_USER_AGENT=
