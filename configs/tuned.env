# Post-paper schedule — NOT the paper's configuration. Reproduces nothing in it.
#
# The paper's warmup occupied 15 of ~20 optimizer steps, which §7 flags as having
# likely limited gains. These values were measured afterwards and converged
# better; they are kept as a preset rather than as defaults so `launch.py` with
# no --config always means the published method. See docs/CONFIG.md.
#
#   python launch.py --config configs/tuned.env
EXTENDS=finsd.env

# ~5% ramp on a ~40-step run instead of 75%.
NUM_WARMUP_STEPS=2
# Roughly doubles the optimizer-step count; noisier per-step gradient.
GRAD_ACCUM_STEPS=8
# Cosine decay over epochs down to 10% of peak LR, so the run ends on small steps.
LR_DECAY_FLOOR=0.1
