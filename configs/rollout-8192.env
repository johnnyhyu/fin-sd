# Untruncated rollout — §6.3. Fin-SD with the distillation rollout cap L raised
# from 100 to the full reasoning budget, so the KL is summed over the whole
# completion rather than concentrated at the failure point.
#
# Costs training memory: the backward buffer scales with rollout length.
#
#   python launch.py --config configs/rollout-8192.env
EXTENDS=finsd.env

MAX_PROBE_TOKENS=8192
