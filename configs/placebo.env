# Placebo hint — §5.3. Fin-SD with the critique replaced by a fixed string that
# carries no problem-specific information ("Your mistake is conceptual."), which
# is what HINT_MODE=vague emits for a conceptual error. Everything else is held
# constant, isolating hint CONTENT from where the supervision is applied.
#
#   python launch.py --config configs/placebo.env
EXTENDS=finsd.env

HINT_MODE=vague
