# Fin-SD — the paper's method. This is the base preset; every other arm extends it.
#
#   python launch.py --config configs/finsd.env
#
# Each value below is pinned to Table 1 of the paper so the table and this file can
# be diffed by eye. These are also the code defaults in pipeline/config.py, so this
# file is a specification, not a set of overrides — if a value here ever disagrees
# with the code default, the code has drifted.
#
# Precedence: shell environment > preset > .env > code default.

# ── Method (§3) ───────────────────────────────────────────────────────────────
# Hint content: the Fin-SD critique, "Your logic diverges when X... Assume Y."
# (Figure 2). NOT "vague" — that is the placebo arm; see configs/placebo.env.
HINT_MODE=full
# Hint writer π_H = self: the frozen teacher writes its own hint (Table 1).
# configs/hint-120b.env swaps in GPT-OSS-120B for the §6.1 ablation.
HINT_VIA_VLLM=1
# Reverse KL(student ‖ teacher) over the student's own rollouts (§3.4).
STUDENT_ROLLOUT=1
STUDENT_ROLLOUT_FORWARD=0
# Distillation rollout cap L = 100 tokens (Table 1, §3.4).
MAX_PROBE_TOKENS=100
# Arithmetic-only failures are localized but contribute no gradient (§3.2).
SKIP_ARITHMETIC_ERRORS=1

# ── Model and optimization (Table 1) ──────────────────────────────────────────
# The repo default is the 120B; the paper's student is the 20B. Both entries must
# name it, or the trainer and the served model diverge. Expert LoRA needs BF16 for
# the trainer, since the merged checkpoint vLLM serves is full precision.
HF_MODEL_PATH=unsloth/gpt-oss-20b-BF16
VLLM_MODEL=unsloth/gpt-oss-20b
LORA_RANK=64
LORA_ALPHA=128
LORA_EXPERT_RANK=8
LORA_TARGET_EXPERTS=1
LEARNING_RATE=2e-5
NUM_WARMUP_STEPS=15
# 1.0 = warmup-then-constant. The paper's schedule has no decay floor.
LR_DECAY_FLOOR=1.0
ADAM_BETA1=0.9
ADAM_BETA2=0.95
WEIGHT_DECAY=0.0
# Gradient clipping is fixed at max_norm=1.0 in optimization_script.py.

# ── Batching and data (Table 1) ───────────────────────────────────────────────
# Effective batch = TRAIN_BATCH_SIZE × GRAD_ACCUM_STEPS = 16.
TRAIN_BATCH_SIZE=1
GRAD_ACCUM_STEPS=16
TRAIN_VAL_SPLIT=0.8
NUM_EPOCHS=10
# Reasoning rollout cap (Table 1).
MAX_NEW_TOKENS=8192
# Greedy decoding: run-to-run spread is not sampling variance (§4.3).
TEMPERATURE=0.0

# ── Not in the paper — off here, opt in explicitly ────────────────────────────
# Post-paper addition; see configs/length-penalty.env and docs/CONFIG.md.
LENGTH_PENALTY=0

# ── Seeds ─────────────────────────────────────────────────────────────────────
# The paper sweeps 7, 42, 72, 2, 27 (§4.3). Override per run: SEED=42 python launch.py ...
SEED=7
