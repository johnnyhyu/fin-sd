# Length penalty — POST-PAPER. Not used by any result in the paper.
#
# Adds a soft penalty on the loss for rollouts running toward the token budget,
# ramping from LENGTH_SOFT_FRAC of MAX_NEW_TOKENS. See docs/CONFIG.md and
# pipeline/config.py §7 for the shape and the one reward hack to watch for
# (terminating early with a guessed answer).
#
#   python launch.py --config configs/length-penalty.env
EXTENDS=finsd.env

LENGTH_PENALTY=1
LENGTH_PENALTY_WEIGHT=0.05
LENGTH_SOFT_FRAC=0.7
LENGTH_PENALTY_POWER=2.0
LENGTH_PENALTY_WINDOW=128
