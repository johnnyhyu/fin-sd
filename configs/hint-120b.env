# 120B hint writer — §6.1. Fin-SD with the hint written by GPT-OSS-120B (a
# same-family model at ~6x the parameters) instead of the frozen teacher itself.
# The hint model contributes no gradient either way (§3.1).
#
# Requires OPENROUTER_API_KEY: HINT_VIA_VLLM=0 routes hint generation to the
# fixed OpenRouter model rather than the live vLLM policy.
#
#   python launch.py --config configs/hint-120b.env
EXTENDS=finsd.env

HINT_VIA_VLLM=0
OPENROUTER_HINT_MODEL=openai/gpt-oss-120b
