# SFT baseline — supervised fine-tuning on teacher reference solutions, the
# weakest baseline in §5.2 and Table 2 (it underperforms the base model there).
#
# Stage 1 has the teacher solve every problem, keeping only traces whose final
# answer matches ground truth (rejection sampling). Stage 2 is a plain next-token
# loss over the resulting pairs — no student rollouts, no KL, fully off-policy.
#
#   python -m sft.run --config configs/sft.env
EXTENDS=finsd.env

# Teacher that writes the traces; needs OPENROUTER_API_KEY.
OPENROUTER_HINT_MODEL=openai/gpt-oss-120b
# SFT converges much faster than the distillation runs and overfits 220 problems
# quickly, so it uses a shorter schedule at a higher LR than Table 1.
SFT_NUM_EPOCHS=3
SFT_LEARNING_RATE=1e-4
# Supervise prompt+completion (0) or the completion only (1).
SFT_MASK_PROMPT=0
