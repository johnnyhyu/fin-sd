# OPSD baseline — on-policy self-distillation from full reference solutions
# (Zhao et al.), the primary baseline in §5.2 and Table 2.
#
# The teacher/student difference is pure context: the teacher's prompt carries a
# complete verified reference solution, the student's carries only the question.
# Contrast with Fin-SD, which gives the teacher a short critique at the localized
# failure point instead.
#
# Runs through its own entrypoint, not launch.py. Stage 1 needs OPENROUTER_API_KEY
# to write the reference solutions; stage 2 trains on them.
#
#   python -m opsd.run --config configs/opsd.env
#
# Shares the student, LoRA, serving and grader settings below via pipeline.config.
EXTENDS=finsd.env

# Model that writes the reference solutions (stage 1).
OPSD_HINT_MODEL=openai/gpt-oss-120b
# Answer-appended retries while building a reference that reaches ground truth.
OPSD_REFERENCE_MAX_ATTEMPTS=4
# One student rollout per wrong problem, scored under forward KL(teacher ‖ student).
OPSD_NUM_ROLLOUTS=1
# OPSD scores the full completion rather than Fin-SD's L=100 window.
OPSD_MAX_ROLLOUT_TOKENS=1024
OPSD_ROLLOUT_TEMPERATURE=1.0
OPSD_ROLLOUT_TOP_P=0.9
